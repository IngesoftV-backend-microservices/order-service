<configuration>
  <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
    </encoder>
  </appender>

  <!-- Silence logs from CartServiceImpl in tests to avoid confusion with intentionally thrown exceptions -->
  <logger name="com.selimhorri.app.service.impl.CartServiceImpl" level="OFF"/>

  <!-- Keep reasonable defaults for the rest -->
  <root level="INFO">
    <appender-ref ref="STDOUT" />
  </root>
</configuration>
